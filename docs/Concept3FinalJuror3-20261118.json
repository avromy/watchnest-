      "evidence": [
        "J15",
        "J16",
        "J23",
        "X09"
      ],
      "finding": "Select all children is plain muted text beside prominent checkbox chips; it has weak control affordance. Individual child selection remains unambiguous.",
      "suggestion": "Use a visible checkbox or outlined compact button for select all."
    },
    {
      "id": "N3",
      "evidence": [
        "J19",
        "J20",
        "X05",
        "X14",
        "X15"
      ],
      "finding": "Parent Time repeats long technical timer explanations under each child and below all cards. Main time actions remain clear, but later-child access on phone requires substantial scrolling.",
      "suggestion": "Move common explanations to one Help disclosure and preserve child-specific connectivity status."
    }
  ],
